# ENTSO-E Transparency Platform RESTful API token
# How to obtain:
#   1. Register at https://transparency.entsoe.eu
#   2. Email transparency@entsoe.eu with subject "RESTful API access"
#      and your registered email in the body
#   3. After approval (1-3 working days), generate the token in
#      My Account Settings -> Web API Security Token
ENTSOE_API_KEY=your_entsoe_token_here

# Anthropic API key for the LLM-driven pipeline component
# Get one from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
