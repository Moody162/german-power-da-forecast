# ============================================================
# Secrets — NEVER commit
# ============================================================
.env
*.env
!.env.example

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ============================================================
# Data — raw parquets ARE committed (evaluator skips 15-min ingestion)
# Processed data and QA outputs are generated, not committed (except reports)
# ============================================================
data/processed/*
data/qa/*
!data/processed/.gitkeep
!data/qa/.gitkeep
!data/qa/qa_report.md
!data/qa/qa_report.json
!data/qa/qa_report_clean.md
!data/qa/qa_report_clean.json
!data/qa/impute_log.json

# ============================================================
# Outputs — figures/tables/predictions ARE committed (final artifacts)
# Logs are runtime artifacts, not committed
# ============================================================
outputs/logs/*.log
outputs/**/*.tmp
outputs/**/*.pkl

# ============================================================
# Notebooks
# ============================================================
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ============================================================
# OS noise
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Editor / IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# uv
# ============================================================
# .python-version IS committed (pins Python version for reproducibility)
# uv.lock IS committed (pins dependency versions)
CLAUDE.md
